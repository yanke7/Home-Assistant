{
  "netflix_tv": {
    "alias": "Netflix TV",
    "mode": "single",
    "sequence": [
      {
        "action": "remote.send_command",
        "target": {
          "entity_id": "remote.office"
        },
        "data": {
          "command": "wakeup"
        }
      },
      {
        "action": "media_player.select_source",
        "target": {
          "entity_id": "media_player.office"
        },
        "data": {
          "source": "Netflix"
        }
      }
    ]
  },
